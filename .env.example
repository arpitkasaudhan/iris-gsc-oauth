# OAuth client of type "Web application" from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback

# AES-256-GCM key ring for tokens at rest: "kid:base64url(32 bytes)", comma separated.
# The FIRST key encrypts, every key can decrypt (rotation = prepend a new key).
# Generate: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEYS=k1:REPLACE_ME

# Signs the session cookie
SESSION_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_STRING

DATABASE_URL=sqlite:///./gsc_oauth.db

# Stand-in for the host product's real login. Never enable in production.
ENABLE_DEV_LOGIN=true

# Cross-Account Protection (RISC) receiver at POST /risc/events
RISC_ENABLED=false
